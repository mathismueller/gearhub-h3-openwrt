#!/bin/sh
# OpenWrt reset button handler for PL4 (KEY_RESTART).
# Short press (<1s): ignored. Hold 1-4s: reboot. Hold >=5s: factory reset (firstboot).

. /lib/functions.sh

OVERLAY="$(grep -E ' /overlay ' /proc/mounts)"

case "$ACTION" in
pressed)
	[ -z "$OVERLAY" ] && return 0
	return 5
;;
timeout)
	. /etc/diag.sh
	set_state failsafe
;;
released)
	if [ "$SEEN" -lt 1 ]; then
		return 0
	elif [ "$SEEN" -ge 5 ]; then
		echo "FACTORY RESET" > /dev/console
		jffs2reset -y && reboot &
	else
		echo "REBOOT" > /dev/console
		sync
		reboot &
	fi
;;
esac

return 0
