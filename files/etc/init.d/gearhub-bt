#!/bin/sh /etc/rc.common
START=62

start() {
	[ -s /lib/firmware/brcm/BCM43430A1.hcd ] || return 0
	[ -c /dev/ttyS1 ] || return 0

	# Enable PCF8563 32.768 kHz LPO clock (required by BCM43430 UART PLL)
	i2cset -f -y 0 0x51 0x0d 0x80 2>/dev/null || true

	# Pulse BT_REG_ON (PD4 = gpiochip0 line 100) and hold high
	gpioset -c gpiochip0 -t 100ms,0 100=0 2>/dev/null || true
	gpioset -z -c gpiochip0 100=1 2>/dev/null || true

	hciattach /dev/ttyS1 bcm43xx 115200 flow /lib/firmware/brcm/BCM43430A1.hcd >/dev/null 2>&1 || return 1
	sleep 1
	hciconfig hci0 up 2>/dev/null || true
}

stop() {
	hciconfig hci0 down 2>/dev/null || true
	killall hciattach 2>/dev/null || true
	killall gpioset 2>/dev/null || true
}
